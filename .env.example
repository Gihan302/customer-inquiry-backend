# ---- Server ----
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=customer_inquiry_db
DB_USER=postgres
DB_PASSWORD=change_me
# Optional: separate database used only by automated tests (default shown)
TEST_DB_NAME=customer_inquiry_test_db

# ---- Auth ----
# Use a long random string, e.g. generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=10

# ---- Seeding (optional) ----
# Password for the seeded staff accounts. If unset, the documented local
# development default "Password123!" is used (refused when NODE_ENV=production).
# SEED_STAFF_PASSWORD=
